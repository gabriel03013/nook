generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [citext, pgcrypto, uuid_ossp(map: "uuid-ossp", schema: "extensions")]
  schemas    = ["app", "public"]
}

// ============================================================================
// USERS & IDENTITY
// ============================================================================

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model User {
  id        String     @id @db.Uuid
  email     String?    @unique
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?  @map("deleted_at") @db.Timestamptz(6)

  // owned (1-1 / 1-n)
  profile                Profile?
  preferences            UserPreference?
  listenerAvailability   ListenerAvailability?
  roles                  UserRole[]
  checkIns               CheckIn[]
  diaryEntries           DiaryEntry[]
  posts                  Post[]
  comments               Comment[]
  postReactions          PostReaction[]
  commentReactions       CommentReaction[]
  notifications          Notification[]
  savedItems             SavedItem[]
  distractionCompletions DistractionCompletion[]
  analyticsEvents        AnalyticsEvent[]
  auditLogs              AuditLog[]
  reportsFiled           Report[]
  moderationActionsTaken ModerationAction[]
  circlesCreated         Circle[]
  circleParticipations   CircleParticipant[]
  circleMessages         CircleMessage[]
  supportLettersAuthored SupportLetter[]
  supportLettersReceived SupportLetterDelivery[]

  // self-referencing via Block
  blockedBy Block[] @relation("BlockedUser") // people who blocked me
  blocking  Block[] @relation("BlockerUser") // people I blocked

  // self-referencing via PresenceRequest
  presenceRequestsMade     PresenceRequest[] @relation("PresenceRequester")
  presenceRequestsAccepted PresenceRequest[] @relation("PresenceAcceptedBy")

  // self-referencing via UserWarning
  warnings       UserWarning[] @relation("WarningTarget") // warnings I received
  warningsIssued UserWarning[] @relation("WarningModerator") // warnings I issued (as a moderator)

  @@index([createdAt(sort: Desc)], map: "idx_users_created_at")
  @@index([status], map: "idx_users_status")
  @@map("users")
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Profile {
  id          String   @id @default(dbgenerated("app.uuidv7()")) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  displayName String   @map("display_name")
  username    String   @unique @db.Citext
  bio         String?
  avatarPath  String?  @map("avatar_path")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([username], map: "idx_profiles_username")
  @@map("profiles")
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model UserPreference {
  id                   String   @id @default(dbgenerated("app.uuidv7()")) @db.Uuid
  userId               String   @unique @map("user_id") @db.Uuid
  allowAdviceDefault   Boolean  @default(false) @map("allow_advice_default")
  anonymousByDefault   Boolean  @default(false) @map("anonymous_by_default")
  showSensitiveTopics  Boolean  @default(true) @map("show_sensitive_topics")
  receiveNotifications Boolean  @default(true) @map("receive_notifications")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("user_preferences")
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model UserRole {
  id        String   @id @default(dbgenerated("app.uuidv7()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      Role
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, role], map: "uq_user_roles_user_role")
  @@index([role], map: "idx_user_roles_role")
  @@index([userId], map: "idx_user_roles_user_id")
  @@map("user_roles")
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model UserWarning {
  id          String   @id @default(dbgenerated("app.uuidv7()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  moderatorId String?  @map("moderator_id") @db.Uuid
  reason      String
  message     String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  targetUser User  @relation("WarningTarget", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  moderator  User? @relation("WarningModerator", fields: [moderatorId], references: [id], onUpdate: NoAction)

  @@index([userId, createdAt(sort: Desc)], map: "idx_warnings_user")
  @@map("user_warnings")
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Block {
  id        String   @id @default(dbgenerated("app.uuidv7()")) @db.Uuid
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  reason    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  blocker User @relation("BlockerUser", fields: [blockerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  blocked User @relation("BlockedUser", fields: [blockedId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([blockerId, blockedId], map: "uq_blocks")
  @@index([blockedId], map: "idx_blocks_blocked")
  @@index([blockerId], map: "idx_blocks_blocker")
  @@map("blocks")
  @@schema("public")
}

