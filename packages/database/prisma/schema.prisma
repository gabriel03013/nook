// ============================================================================
// POSTS & COMMENTS
// ============================================================================

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Post {
  id                 String        @id @default(dbgenerated("app.uuidv7()")) @db.Uuid
  authorId           String        @map("author_id") @db.Uuid
  content            String
  topic              String?
  intent             PostIntent
  emotionalIntensity Int?          @map("emotional_intensity") @db.SmallInt
  allowAdvice        Boolean       @default(false) @map("allow_advice")
  anonymous          Boolean       @default(false)
  status             ContentStatus @default(PUBLISHED)
  firstResponseAt    DateTime?     @map("first_response_at") @db.Timestamptz(6)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?     @map("deleted_at") @db.Timestamptz(6)

  author       User           @relation(fields: [authorId], references: [id], onUpdate: NoAction)
  comments     Comment[]
  reactions    PostReaction[]
  diaryEntries DiaryEntry[]

  @@index([authorId, createdAt(sort: Desc)], map: "idx_posts_author_created")
  @@index([intent], map: "idx_posts_intent")
  @@index([status, createdAt(sort: Desc)], map: "idx_posts_status_created")
  @@map("posts")
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Comment {
  id           String              @id @default(dbgenerated("app.uuidv7()")) @db.Uuid
  postId       String              @map("post_id") @db.Uuid
  authorId     String              @map("author_id") @db.Uuid
  content      String
  responseType CommentResponseType @map("response_type")
  anonymous    Boolean             @default(false)
  status       ContentStatus       @default(PUBLISHED)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?           @map("deleted_at") @db.Timestamptz(6)

  author    User              @relation(fields: [authorId], references: [id], onUpdate: NoAction)
  post      Post              @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reactions CommentReaction[]

  @@index([authorId, createdAt(sort: Desc)], map: "idx_comments_author_created")
  @@index([postId, createdAt], map: "idx_comments_post_created")
  @@index([responseType], map: "idx_comments_response_type")
  @@index([status, createdAt(sort: Desc)], map: "idx_comments_status_created")
  @@map("comments")
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model PostReaction {
  id        String       @id @default(dbgenerated("app.uuidv7()")) @db.Uuid
