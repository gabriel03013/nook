  @@unique([userId, commentId, type], map: "uq_comment_reactions")
  @@index([commentId], map: "idx_comment_reactions_comment")
  @@index([userId], map: "idx_comment_reactions_user")
  @@map("comment_reactions")
  @@schema("public")
}

