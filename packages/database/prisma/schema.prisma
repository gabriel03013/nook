generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [citext, pgcrypto, uuid_ossp(map: "uuid-ossp", schema: "extensions")]
  schemas    = ["app", "public"]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model analytics_events {
  id         String               @id @default(dbgenerated("app.uuidv7()")) @db.Uuid
  user_id    String?              @db.Uuid
  type       analytics_event_type
  metadata   Json?
  created_at DateTime             @default(now()) @db.Timestamptz(6)
  users      users?               @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([type, created_at(sort: Desc)], map: "idx_analytics_type_created")
  @@schema("public")
}

